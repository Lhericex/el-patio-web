  <div class="img-modal" id="imgModal" aria-hidden="true">
    <div class="img-modal-backdrop" id="imgModalBackdrop"></div>
    <div class="img-modal-card" role="dialog" aria-modal="true" aria-labelledby="imgModalName">
      <div class="img-modal-media">
        <img id="imgModalPhoto" src="" alt="">
        <span class="img-modal-price" id="imgModalPrice"></span>
        <button class="img-modal-close" id="imgModalClose" aria-label="Cerrar">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
        </button>
      </div>
      <div class="img-modal-body">
        <span class="img-modal-tag" id="imgModalTag"></span>
        <h3 id="imgModalName"></h3>
        <p id="imgModalDesc"></p>
      </div>
    </div>
  </div>
</section>

<script>
  // ---------- image modal ----------
  const modal = document.getElementById('imgModal')!;
  const modalPhoto = document.getElementById('imgModalPhoto') as HTMLImageElement;
  const modalName = document.getElementById('imgModalName')!;
  const modalTag = document.getElementById('imgModalTag')!;
  const modalPrice = document.getElementById('imgModalPrice')!;
  const modalDesc = document.getElementById('imgModalDesc')!;

  function openModal(card: HTMLElement){
    const img = card.querySelector('img');
    const price = card.querySelector('.menu-card-price');
    const desc = card.querySelector('.menu-card-desc');
    modalPhoto.src = img?.getAttribute('src') || '';
    modalPhoto.alt = card.dataset.name || '';
    modalName.textContent = card.dataset.name || '';
    modalTag.textContent = card.dataset.cat || '';
    modalPrice.textContent = price?.textContent || '';
    modalDesc.textContent = desc?.textContent || '';
    modal.classList.add('open');
    modal.setAttribute('aria-hidden', 'false');
  }
  function closeModal(){
    modal.classList.remove('open');
    modal.setAttribute('aria-hidden', 'true');
  }
  document.getElementById('imgModalClose')?.addEventListener('click', closeModal);
  document.getElementById('imgModalBackdrop')?.addEventListener('click', closeModal);
  window.addEventListener('keydown', (e) => { if(e.key === 'Escape') closeModal(); });

  document.querySelectorAll<HTMLElement>('.menu-card').forEach(card => {
    card.addEventListener('click', () => openModal(card));
  });

  // ---------- search + category filter ----------
  const searchInput = document.getElementById('menuSearch') as HTMLInputElement | null;
  const filterButtons = document.querySelectorAll<HTMLElement>('#menuFilters [data-filter]');
  const emptyState = document.getElementById('menuEmpty');
  const groups = document.querySelectorAll<HTMLElement>('.menu-cat-block');
  let activeFilter = 'all';

  function normalize(s: string){
    return s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '');
  }

  function applyFilters(){
    const query = normalize(searchInput?.value || '');
    let anyVisible = false;

    groups.forEach(group => {
      const cat = group.dataset.cat || '';
      const groupMatchesFilter = activeFilter === 'all' || cat === activeFilter;
      let groupHasVisibleItem = false;

      group.querySelectorAll<HTMLElement>('.menu-card').forEach(card => {
        const tag = card.querySelector('.menu-card-tag')?.textContent || '';
        const desc = card.querySelector('.menu-card-desc')?.textContent || '';
        const haystack = normalize(`${card.dataset.name || ''} ${tag} ${desc}`);
        const show = groupMatchesFilter && haystack.includes(query);
        card.style.display = show ? '' : 'none';
        if(show) groupHasVisibleItem = true;
      });

      group.style.display = groupHasVisibleItem ? '' : 'none';
      if(groupHasVisibleItem) anyVisible = true;
    });

    if(emptyState) emptyState.hidden = anyVisible;
  }

  searchInput?.addEventListener('input', applyFilters);
  filterButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      filterButtons.forEach(b => b.classList.remove('is-active'));
      btn.classList.add('is-active');
      activeFilter = btn.dataset.filter || 'all';
      applyFilters();
    });
  });

  applyFilters();

  // ---------- horizontal carousels (one per category) ----------
  document.querySelectorAll<HTMLElement>('.menu-carousel-wrap').forEach(wrap => {
    const track = wrap.querySelector<HTMLElement>('.menu-cards-carousel');
    const prev = wrap.querySelector<HTMLElement>('[data-dir="prev"]');
    const next = wrap.querySelector<HTMLElement>('[data-dir="next"]');
    if(!track) return;
    const step = () => Math.min(track.clientWidth * 0.8, 600);
    prev?.addEventListener('click', () => track.scrollBy({left:-step(), behavior:'smooth'}));
    next?.addEventListener('click', () => track.scrollBy({left:step(), behavior:'smooth'}));
  });
</script>

</Layout>
